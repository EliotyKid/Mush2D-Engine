# Games: every game is a folder with project.json, assets/ and src/<id>/, built as its own static library.
#
#   mush2d_add_game(<id> <dir> <GameClass> <header>)
#     <id>        the game's id, used by --game (also the folder name under src/, for example my_game)
#     <dir>       the game's folder, relative to the project root (for example games/my_game)
#     <GameClass> the game's IGame subclass (for example MyGame)
#     <header>    the header that declares it, relative to <dir>/src (for example my_game/MyGame.hpp)
#
#   mush2d_write_games_list()           after every mush2d_add_game: writes games_list.cpp
#   mush2d_copy_game_files(<target>)    copies each game's project.json and assets/ next to <target>

# Makes <id>_game (STATIC) from <dir>/src/**/*.cpp, plus a generated <id>_objects.cpp that includes every
# <dir>/src/<id>/objects/*.hpp, so the MUSH2D_OBJECT registrations in those headers are compiled in.
function(mush2d_add_game id dir game_class header)
    set(game_dir ${CMAKE_SOURCE_DIR}/${dir})
    file(GLOB_RECURSE game_sources CONFIGURE_DEPENDS ${game_dir}/src/*.cpp)

    # One #include line per object header.
    file(GLOB object_headers CONFIGURE_DEPENDS ${game_dir}/src/${id}/objects/*.hpp)
    set(MUSH2D_OBJECT_INCLUDES "")
    foreach(object_header ${object_headers})
        file(RELATIVE_PATH header_rel ${game_dir}/src ${object_header})
        string(APPEND MUSH2D_OBJECT_INCLUDES "#include \"${header_rel}\"\n")
    endforeach()
    set(MUSH2D_GAME_ID ${id})
    set(objects_cpp ${CMAKE_BINARY_DIR}/generated/${id}_objects.cpp)
    file(CONFIGURE OUTPUT ${objects_cpp} CONTENT
"// Generated by cmake/Games.cmake from ${dir}/src/${id}/objects/*.hpp. Do not edit.
@MUSH2D_OBJECT_INCLUDES@
// The includes above register the types. Calling this (games_list.cpp, the tests) makes the linker keep
// this file, and with it every registration.
void mush2dLinkGame_@MUSH2D_GAME_ID@() {}
" @ONLY)

    add_library(${id}_game STATIC ${game_sources} ${objects_cpp})
    target_include_directories(${id}_game PUBLIC ${game_dir}/src)
    target_link_libraries(${id}_game PUBLIC mush2d_engine)

    # The display name comes from the game's project.json; editing it re-runs the configure.
    file(READ ${game_dir}/project.json project_json)
    string(JSON game_name GET "${project_json}" name)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${game_dir}/project.json)

    # Remembers the game for mush2d_write_games_list and mush2d_copy_game_files.
    set_property(GLOBAL APPEND PROPERTY MUSH2D_GAME_IDS ${id})
    set_property(GLOBAL PROPERTY MUSH2D_GAME_${id}_DIR ${dir})
    set_property(GLOBAL PROPERTY MUSH2D_GAME_${id}_NAME ${game_name})
    set_property(GLOBAL PROPERTY MUSH2D_GAME_${id}_CLASS ${game_class})
    set_property(GLOBAL PROPERTY MUSH2D_GAME_${id}_HEADER ${header})
endfunction()

# Writes <build>/generated/games_list.cpp, which defines compiledGames() (engine/core/GameRegistry.hpp).
# Sets, in the caller: MUSH2D_GAMES_LIST (that file) and MUSH2D_GAME_LIBS (every <id>_game library).
function(mush2d_write_games_list)
    get_property(ids GLOBAL PROPERTY MUSH2D_GAME_IDS)
    set(MUSH2D_GAME_INCLUDES "")
    set(MUSH2D_GAME_LINKS "")
    set(MUSH2D_GAME_ENTRIES "")
    set(libs "")
    foreach(id ${ids})
        get_property(dir GLOBAL PROPERTY MUSH2D_GAME_${id}_DIR)
        get_property(name GLOBAL PROPERTY MUSH2D_GAME_${id}_NAME)
        get_property(game_class GLOBAL PROPERTY MUSH2D_GAME_${id}_CLASS)
        get_property(header GLOBAL PROPERTY MUSH2D_GAME_${id}_HEADER)
        string(APPEND MUSH2D_GAME_INCLUDES "#include \"${header}\"\n")
        string(APPEND MUSH2D_GAME_LINKS "void mush2dLinkGame_${id}();\n")
        string(APPEND MUSH2D_GAME_ENTRIES
            "        mush2dLinkGame_${id}();\n"
            "        games.push_back({\"${id}\", \"${name}\", \"${dir}\", [] { return std::unique_ptr<IGame>(std::make_unique<${game_class}>()); }});\n")
        list(APPEND libs ${id}_game)
    endforeach()
    set(list_cpp ${CMAKE_BINARY_DIR}/generated/games_list.cpp)
    file(CONFIGURE OUTPUT ${list_cpp} CONTENT
"// Generated by cmake/Games.cmake from the mush2d_add_game calls. Do not edit.
#include \"engine/core/GameRegistry.hpp\"
@MUSH2D_GAME_INCLUDES@
// Each game's generated <id>_objects.cpp.
@MUSH2D_GAME_LINKS@
const std::vector<GameEntry>& compiledGames() {
    // Built once, on the first call.
    static const std::vector<GameEntry> table = [] {
        std::vector<GameEntry> games;
@MUSH2D_GAME_ENTRIES@        return games;
    }();
    return table;
}
" @ONLY)
    set(MUSH2D_GAMES_LIST ${list_cpp} PARENT_SCOPE)
    set(MUSH2D_GAME_LIBS ${libs} PARENT_SCOPE)
endfunction()

# Copies every game's project.json and assets/ to <dir of target>/<game dir>/, where assetPath looks.
function(mush2d_copy_game_files target)
    get_property(ids GLOBAL PROPERTY MUSH2D_GAME_IDS)
    foreach(id ${ids})
        get_property(dir GLOBAL PROPERTY MUSH2D_GAME_${id}_DIR)
        set(out $<TARGET_FILE_DIR:${target}>/${dir})
        # No outputs: runs on every build, so edits to the game's files always land.
        add_custom_target(${target}_${id}_files ALL
            COMMAND ${CMAKE_COMMAND} -E make_directory ${out}
            COMMAND ${CMAKE_COMMAND} -E copy_if_different ${CMAKE_SOURCE_DIR}/${dir}/project.json ${out}/project.json
            COMMAND ${CMAKE_COMMAND} -E copy_directory ${CMAKE_SOURCE_DIR}/${dir}/assets ${out}/assets
            VERBATIM)
        add_dependencies(${target} ${target}_${id}_files)
    endforeach()
endfunction()
